# Copy to .env and change the passwords before exposing anything beyond your own machine.
POSTGRES_USER=callsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callsight

MINIO_ROOT_USER=callsight
MINIO_ROOT_PASSWORD=change-me-too

# "none" = rule-based analysis only. "ollama" = also generate summaries with a local model
# (start it with: docker compose --profile local-llm up).
CALLSIGHT_LLM_PROVIDER=none
CALLSIGHT_OLLAMA_URL=http://ollama:11434
CALLSIGHT_OLLAMA_MODEL=llama3.1

# Comma-separated. Competitor names to flag when mentioned on a call.
CALLSIGHT_COMPETITORS=
# Comma-separated. Speaker names that are your reps (default: whoever speaks first).
CALLSIGHT_REP_NAMES=
# faster-whisper model for the worker: tiny, base, small, medium, large-v3 (bigger = slower, more accurate).
CALLSIGHT_WHISPER_MODEL=small
# Signs short-lived recording links. Set a long random value (e.g. `openssl rand -hex 32`).
CALLSIGHT_SECRET_KEY=
# Comma-separated analyzers; leave empty for the defaults. Without an LLM:
#   talk_ratio,objections,competitors,next_step,action_items
# With CALLSIGHT_LLM_PROVIDER=ollama the default is the measured hybrid:
#   talk_ratio,competitors,action_items,llm_insights
CALLSIGHT_ANALYZERS=
