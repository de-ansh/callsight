# Copy to .env and change the passwords before exposing anything beyond your own machine.

# Host ports (change if something else already uses them).
CALLSIGHT_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_USER=callsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callsight

MINIO_ROOT_USER=callsight
MINIO_ROOT_PASSWORD=change-me-too

# "none" = rule-based analysis only. "ollama" = also generate summaries with a local model
# (start it with: docker compose --profile local-llm up).
CALLSIGHT_LLM_PROVIDER=none
CALLSIGHT_OLLAMA_URL=http://ollama:11434
CALLSIGHT_OLLAMA_MODEL=llama3.1

# Comma-separated competitor names flagged for EVERY organization. Each org can also keep its own
# list on the Settings page (GET/PUT /v1/settings); both apply.
CALLSIGHT_COMPETITORS=
# Comma-separated. Speaker names that are your reps (default: whoever speaks first).
CALLSIGHT_REP_NAMES=
# faster-whisper model for the worker: tiny, base, small, medium, large-v3 (bigger = slower, more accurate).
CALLSIGHT_WHISPER_MODEL=small
# Separate speakers in mono recordings (Zoom/Meet exports). Needs the image built with
#   docker compose build --build-arg EXTRAS=asr,diarize
# and a Hugging Face token from an account that accepted the model's terms:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
CALLSIGHT_DIARIZATION=
HF_TOKEN=
# Signs short-lived recording links. Set a long random value (e.g. `openssl rand -hex 32`).
CALLSIGHT_SECRET_KEY=
# Single sign-on with any OpenID Connect provider (Google Workspace, Microsoft Entra ID, Okta, Keycloak, ...).
# Register callsight with your provider using the redirect URI  <CALLSIGHT_PUBLIC_URL>/auth/callback
# then allow email domains: python -m callsight.admin allow-domain --org acme --domain acme.com
CALLSIGHT_PUBLIC_URL=http://localhost:8000
CALLSIGHT_OIDC_ISSUER=
CALLSIGHT_OIDC_CLIENT_ID=
CALLSIGHT_OIDC_CLIENT_SECRET=
# Delete calls and their recordings after this many days (the worker checks hourly). 0 = keep forever.
CALLSIGHT_RETENTION_DAYS=0
# Comma-separated analyzers; leave empty for the defaults. Without an LLM:
#   talk_ratio,objections,competitors,next_step,action_items
# With CALLSIGHT_LLM_PROVIDER=ollama the default is the measured hybrid:
#   talk_ratio,competitors,action_items,llm_insights
CALLSIGHT_ANALYZERS=
